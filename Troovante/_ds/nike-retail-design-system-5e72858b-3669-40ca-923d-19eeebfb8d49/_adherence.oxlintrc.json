{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/buttons/**",
              "components/content/**",
              "components/forms/**",
              "components/icons/**",
              "components/media/**",
              "components/navigation/**",
              "components/product/**",
              "ui_kits/retail-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bebas Neue|Inter))/i]",
        "message": "Font not provided by the design system. Available: Bebas Neue, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|full|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, full, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|on-image|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'on-image' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|headline|body|cta|onCta|image|imageLabel|ratio|headlineColor|align|headlineSize|style|key|ref|className|style|children)$/]",
        "message": "<CampaignTile> doesn't accept that prop. Declared props: eyebrow, headline, body, cta, onCta, image, imageLabel, ratio, headlineColor, align, headlineSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:bottom-left|top-left)$/]",
        "message": "<CampaignTile> align must be one of 'bottom-left' | 'top-left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryIconCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|image|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CategoryIconCard> doesn't accept that prop. Declared props: label, icon, image, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|emphasis|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<DisclosureRow> doesn't accept that prop. Declared props: label, children, emphasis, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureRow'] > JSXAttribute[name.name='emphasis'] > Literal[value!=/^(?:body|heading)$/]",
        "message": "<DisclosureRow> emphasis must be one of 'body' | 'heading'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|count|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: children, active, count, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterSidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:groups|selected|onToggle|width|style|key|ref|className|style|children)$/]",
        "message": "<FilterSidebar> doesn't accept that prop. Declared props: groups, selected, onToggle, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|variant|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, variant, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|ghost|solid)$/]",
        "message": "<IconButton> variant must be one of 'soft' | 'ghost' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MemberBenefitCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|cta|onCta|image|imageLabel|ratio|style|key|ref|className|style|children)$/]",
        "message": "<MemberBenefitCard> doesn't accept that prop. Declared props: title, body, cta, onCta, image, imageLabel, ratio, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|stage|label|captionAlign|radius|style|children|key|ref|className|style|children)$/]",
        "message": "<Photo> doesn't accept that prop. Declared props: src, alt, ratio, stage, label, captionAlign, radius, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute[name.name='captionAlign'] > Literal[value!=/^(?:center|top-right|bottom-right)$/]",
        "message": "<Photo> captionAlign must be one of 'center' | 'top-right' | 'bottom-right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|compareAt|percentOff|style|key|ref|className|style|children)$/]",
        "message": "<PriceRow> doesn't accept that prop. Declared props: price, compareAt, percentOff, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimaryNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|query|onQueryChange|onLogo|bagCount|style|key|ref|className|style|children)$/]",
        "message": "<PrimaryNav> doesn't accept that prop. Declared props: items, active, onSelect, query, onQueryChange, onLogo, bagCount, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|category|price|compareAt|percentOff|badge|colors|colorCount|image|imageLabel|ratio|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, category, price, compareAt, percentOff, badge, colors, colorCount, image, imageLabel, ratio, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<PromoBadge> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|width|expandedWidth|style|key|ref|className|style|children)$/]",
        "message": "<SearchPill> doesn't accept that prop. Declared props: value, onChange, placeholder, width, expandedWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|locale|legal|legalLinks|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: columns, locale, legal, legalLinks, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:breadcrumb|title|count|filtersHidden|onToggleFilters|sort|onSort|style|key|ref|className|style|children)$/]",
        "message": "<SubNav> doesn't accept that prop. Declared props: breadcrumb, title, count, filtersHidden, onToggleFilters, sort, onSort, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:colors|activeIndex|onSelect|size|style|key|ref|className|style|children)$/]",
        "message": "<SwatchDots> doesn't accept that prop. Declared props: colors, activeIndex, onSelect, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|onLink|style|key|ref|className|style|children)$/]",
        "message": "<UtilityBar> doesn't accept that prop. Declared props: links, onLink, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, color, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
