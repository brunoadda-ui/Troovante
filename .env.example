# Modèle du fichier de réglages. Le vrai fichier s'appelle .env.local :
# il reste sur cet ordinateur et n'est jamais envoyé sur GitHub.

# Supabase > bouton « Connect », ou Project Settings > Data API : « Project URL »
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys : clé « Publishable » (sb_publishable_…)
# ou, sur l'ancien écran, clé « anon public ».
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase > Project Settings > API Keys : clé « Secret » (sb_secret_…)
# ou, sur l'ancien écran, clé « service_role ».
# ATTENTION : cette clé donne tous les droits sur la base. Ne la communiquer à
# personne, ne la coller nulle part ailleurs que dans .env.local.
# Elle sert à enregistrer les objets déposés dans l'Espace professionnel.
SUPABASE_SECRET_KEY=

# Adresses e-mail autorisées à entrer dans l'espace privé (/admin), séparées
# par des virgules. Chacune doit avoir un compte dans Supabase :
# Authentication > Users > Add user (cocher « Auto Confirm User »).
ADMIN_EMAILS=

# Clé du service Bria (https://platform.bria.ai), qui génère la mise en
# situation des objets déposés. Chaque image générée est facturée par Bria.
# Sans cette clé, tout fonctionne mais sans mise en situation.
BRIA_API_TOKEN=
